{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "meta-leadgen-recovery": {
      "schedule": "*/5 * * * *",
      "timezone": "UTC",
      "jitter": 1,
      "path": "/api/cron/meta-leadgen-sweep",
      "requestMethod": "GET"
    },
    "kapa-leads-sync": {
      "schedule": "*/2 * * * *",
      "timezone": "UTC",
      "jitter": 1,
      "path": "/api/cron/kapa-leads-sync",
      "requestMethod": "GET"
    }
  }
}
