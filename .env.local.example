# Copie este arquivo para .env.local e preencha os valores do seu projeto.
# .env.local é ignorado pelo Git — nunca commite valores reais.

# Supabase (client-side; nomes usados por lib/supabase/client.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only; M1-F S4-A2B — Route Handlers de convites).
# NUNCA prefixar com NEXT_PUBLIC_, NUNCA importar de código client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Origem confiável usada para validar Origin e construir o link de convite
# (M1-F S4-A2B). Server-only — nunca derivada de Host/Origin recebido na
# requisição. URL absoluta http/https, sem credenciais, sem path/query.
# Local: http://127.0.0.1:3000
APP_URL=

# Chave HMAC server-only para hash de IP nos endpoints públicos de aceite
# de convite (M1-F S4-C2A). NUNCA reutilizar SUPABASE_SERVICE_ROLE_KEY, a
# anon key ou APP_URL. Exatamente 64 caracteres hexadecimais minúsculos
# (32 bytes). Gere com: openssl rand -hex 32
INVITE_RATE_LIMIT_PEPPER=

# M1-D — estágios remotos do pipeline.
# Permanece false por padrão; ligue somente após a validação do módulo.
# Override via localStorage ('autocrm_ff_remote_stages') funciona SOMENTE em
# development; produção ignora totalmente o override e usa apenas esta variável.
NEXT_PUBLIC_FF_REMOTE_STAGES=false

# M1-E — leads remotos.
# Permanece false por padrão; ligue somente após a validação do módulo.
# Override via localStorage ('autocrm_ff_remote_leads') funciona SOMENTE em
# development; produção ignora totalmente o override e usa apenas esta variável.
NEXT_PUBLIC_FF_REMOTE_LEADS=false

# COMMERCIAL-REMOTE-B1 — Tasks remotas (primeiro domínio comercial local —
# Tasks/Visits/Deals/Sales — migrado para backend próprio, independente dos
# demais). Permanece false por padrão. Exige NEXT_PUBLIC_FF_REMOTE_LEADS=true
# e NEXT_PUBLIC_FF_REMOTE_STAGES=true (Tasks depende do snapshot/tenancy de
# Leads já remoto) — ligar esta flag sem essa base pronta é configuração
# inválida (fail-closed em runtime, nunca cai para localStorage). Com Leads
# já remoto e esta flag ainda false, Tasks fica temporariamente indisponível
# (nem local, nem remoto) — rollout parcial esperado: Tasks nunca volta a
# escrever em localStorage ao lado de Leads remoto. Override via localStorage
# ('autocrm_ff_remote_tasks') funciona SOMENTE em development.
NEXT_PUBLIC_FF_REMOTE_TASKS=false

# COMMERCIAL-REMOTE-VISITS-B1/B2 — Visitas remotas (segundo domínio
# comercial local — Tasks/Visits/Deals/Sales — migrado para backend
# próprio, independente dos demais). Permanece false por padrão. Exige
# NEXT_PUBLIC_FF_REMOTE_LEADS=true (Visits depende do snapshot/tenancy de
# Leads já remoto) — ligar esta flag sem essa base pronta é configuração
# inválida (fail-closed em runtime, nunca cai para localStorage). Não
# depende de NEXT_PUBLIC_FF_REMOTE_STAGES nem de NEXT_PUBLIC_FF_REMOTE_TASKS
# — os quatro domínios comerciais são independentes entre si. Override via
# localStorage ('autocrm_ff_remote_visits') funciona SOMENTE em
# development.
NEXT_PUBLIC_FF_REMOTE_VISITS=false

# COMMERCIAL-REMOTE-DEALS-B2-A — Propostas/negociações remotas (terceiro
# domínio comercial local — Tasks/Visits/Deals/Sales — migrado para backend
# próprio, independente dos demais). Permanece false por padrão. Exige
# NEXT_PUBLIC_FF_REMOTE_LEADS=true (Deals depende do snapshot/tenancy de
# Leads já remoto) — ligar esta flag sem essa base pronta é configuração
# inválida (fail-closed em runtime, nunca cai para localStorage). Não
# depende de NEXT_PUBLIC_FF_REMOTE_STAGES/TASKS/VISITS — os quatro domínios
# comerciais são independentes entre si. Override via localStorage
# ('autocrm_ff_remote_deals') funciona SOMENTE em development.
NEXT_PUBLIC_FF_REMOTE_DEALS=false

# COMMERCIAL-REMOTE-SALES-A2 — Vendas remotas (quarto domínio comercial
# local). Permanece false por padrão. Exige NEXT_PUBLIC_FF_REMOTE_DEALS=true
# especificamente (Sales depende do snapshot/tenancy de Deals já remoto,
# nunca diretamente de Leads/Stages) — ligar esta flag sem Deals pronto é
# configuração inválida (fail-closed em runtime). Resultados (ranking) não
# tem flag própria: deriva inteiramente desta, via useRemoteSalesScreenState.
# Override via localStorage ('autocrm_ff_remote_sales') funciona SOMENTE em
# development.
NEXT_PUBLIC_FF_REMOTE_SALES=false

# M1-F S5-D — usuários ativos (list_company_users/update_profile_name/
# update_membership_role). Permanece false por padrão: as migrations desta
# etapa ainda não foram aplicadas no banco remoto — ligar esta flag antes do
# deploy real das migrations quebraria a seção em produção. Ativação deve
# ocorrer somente como parte de um rollout remoto controlado (backup ->
# migrations aplicadas -> smoke test -> flag).
NEXT_PUBLIC_FF_ACTIVE_USERS=false

# M1-F S5-E1 — edição administrativa de e-mail. Permanece false por padrão;
# exige NEXT_PUBLIC_FF_ACTIVE_USERS=true (a ação vive dentro da seção de
# usuários ativos) além de suas próprias migrations/Route Handler aplicados
# remotamente. As duas flags são independentes uma da outra — ligar esta sem
# ACTIVE_USERS não tem efeito nenhum.
NEXT_PUBLIC_FF_USER_EMAIL_EDIT=false

# M1-F S6 — ciclo de vida empresarial (suspender/reativar/desligar/
# transferir usuários; listagem de suspensos/desligados). Permanece false
# por padrão; exige NEXT_PUBLIC_FF_ACTIVE_USERS=true (mesma dependência de
# USER_EMAIL_EDIT) além das migrations S6-B/S6-C/S6-D/S6-E/S6-E2 aplicadas
# remotamente. Ativação deve ocorrer somente como parte de um rollout remoto
# controlado, nunca isolada.
NEXT_PUBLIC_FF_USER_LIFECYCLE=false

# M1-F S7 — filtro contextual de empresa (aba de Usuários do Super Admin).
# Permanece false por padrão. Sem dependência de segredo. Ativação somente em
# rollout controlado, depois da superfície visual (S7-C) estar pronta.
NEXT_PUBLIC_FF_COMPANY_SELECTOR=false

# M1-F S3-B — área global de administração da plataforma (Empresas), só
# visível para platformRole==='super_admin'. Permanece false por padrão.
# Controla exclusivamente se a superfície existe no bundle/navegação —
# quem pode ver o que continua sendo RLS/is_platform_super_admin() no
# banco, nunca esta flag. Ativação deve ocorrer somente como parte de um
# rollout controlado (ver docs/M1-F-SUPER-ADMIN-USER-LIFECYCLE-DESIGN.md).
NEXT_PUBLIC_FF_PLATFORM_ADMIN=false

# M1-F S8-C2-B2 — leitura comercial do Super Admin (Clientes/Andamento reais
# de qualquer empresa, via RPCs próprias e estreitas — nunca as telas
# locais de Manager/Seller). Permanece false por padrão; independente de
# NEXT_PUBLIC_FF_PLATFORM_ADMIN (controla o acesso à FUNCIONALIDADE, não à
# navegação de Empresas). Ativação somente em rollout controlado.
NEXT_PUBLIC_FF_SUPER_ADMIN_COMMERCIAL_READ=false

# M1-F S8-C2-C2 — mutation comercial do Super Admin (criar/editar Lead com
# empresa explícita). Permanece false por padrão; só é EFETIVA quando
# NEXT_PUBLIC_FF_SUPER_ADMIN_COMMERCIAL_READ também está ligada (decisão do
# chamador, não desta flag) — ligar WRITE sem READ não tem efeito nenhum.
# Ativação somente em rollout controlado, depois de READ já validado.
NEXT_PUBLIC_FF_SUPER_ADMIN_COMMERCIAL_WRITE=false

# META-WEBHOOK — infraestrutura do webhook oficial da Meta (produto
# Webhooks, objeto Page, campo leadgen). Server-only, lidas apenas por
# app/api/webhooks/meta/route.ts via lib/server/meta-webhook/env.ts.
# NUNCA prefixar com NEXT_PUBLIC_, NUNCA usar em código client-side, NUNCA
# commitar valores reais. Enquanto vazias, a rota falha fechado (500) — e
# a Meta só chama a URL depois do Callback configurado no painel.
#
# META_WEBHOOK_VERIFY_TOKEN: string combinada no Meta for Developers e
# reenviada em hub.verify_token no handshake do GET. Gere uma aleatória,
# ex.: openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=
# META_APP_SECRET: App Secret do app Meta — chave HMAC do
# X-Hub-Signature-256 (POST). Extremamente sensível. Copie do painel do
# app (Configurações > Básico). Configurar direto na Vercel, nunca aqui.
META_APP_SECRET=

# META-OAUTH — fundação do fluxo OAuth "Login do Facebook para Empresas".
# Server-only, lida apenas por app/api/integrations/meta/oauth/callback via
# lib/server/meta-oauth/env.ts. NUNCA NEXT_PUBLIC_, NUNCA client-side.
#
# META_OAUTH_STATE_SECRET: chave HMAC INTERNA do CRM (NÃO é META_APP_SECRET,
# NÃO reutilizar INVITE_RATE_LIMIT_PEPPER) usada só para assinar/validar o
# parâmetro OAuth `state` (anti-CSRF, stateless, TTL curto). Exatamente 64
# caracteres hexadecimais minúsculos (32 bytes). Gere com:
# openssl rand -hex 32
# Enquanto vazia, as rotas /start e /callback falham fechado (500).
META_OAUTH_STATE_SECRET=
# META_APP_ID: identificador PÚBLICO do app Meta "KAPA CRM" (aparece na
# URL de autorização OAuth). NÃO é segredo como META_APP_SECRET, mas fica
# server-side nesta fase. Só dígitos. Sem ele, POST /start falha fechado
# (500). Copie de Meta for Developers > Configurações > Básico > ID do app.
META_APP_ID=
# META_LOGIN_CONFIG_ID: ID da Configuration do "Login do Facebook para
# Empresas" (Facebook Login for Business). No fluxo ATUAL da Meta,
# `config_id` SUBSTITUI `scope` na URL de autorização — as permissões são
# definidas DENTRO da Configuration, no painel Meta (App Dashboard >
# Facebook Login for Business > Configurations), NÃO nesta env nem na URL.
# Identificador numérico PÚBLICO. Sem ele, POST /start falha fechado (500).
# Criar/obter manualmente no painel Meta (ainda não criado).
META_LOGIN_CONFIG_ID=
# META_GRAPH_API_VERSION: OPCIONAL. A Meta versiona a Graph API a cada
# trimestre; definir aqui evita mudar código. Formato v<major>.<minor>
# (ex.: v21.0). Se ausente/inválida, usa o default de
# lib/server/meta-oauth/config.ts. CONFIRMAR a versão configurada no app
# antes de produção.
META_GRAPH_API_VERSION=
